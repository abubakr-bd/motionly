rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read-only collections
    // Anyone can read these (powers the public landing page)
    match /portfolio/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blogs/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /testimonials/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /faqs/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pricing/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /team/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /partners/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Settings
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Finance system collections
    match /invoices/{doc} {
      allow read: if true; // Public read enabled for client public invoice tokens
      allow write: if request.auth != null;
    }

    match /clients/{doc} {
      allow read, write: if request.auth != null;
    }

    match /services/{doc} {
      allow read, write: if request.auth != null;
    }

    match /payments/{doc} {
      allow read, write: if request.auth != null;
    }

    match /finance_settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /activity_logs/{doc} {
      allow read: if true;
      allow write: if true; // Allow recording client view logs
    }

    // User access and audit history
    match /users/{doc} {
      allow read, write: if request.auth != null;
    }

    match /admin_access_logs/{doc} {
      allow read: if request.auth != null;
      allow write: if true; // Allow recording login access logs
    }

    // Motionly Team Management Workspace collections
    match /team_tasks/{doc} {
      allow read, write: if request.auth != null;
    }
    match /team_projects/{doc} {
      allow read, write: if request.auth != null;
    }
    match /team_members/{doc} {
      allow read, write: if request.auth != null;
    }
    match /team_notifications/{doc} {
      allow read, write: if request.auth != null;
    }
    match /team_comments/{doc} {
      allow read, write: if request.auth != null;
    }
    match /team_activity/{doc} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
